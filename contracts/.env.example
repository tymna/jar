# No private keys here! Signing uses a Foundry keystore account:
#   cast wallet import jar-deployer --interactive
FOUNDRY_ACCOUNT=jar-deployer

# Per-chain RPC endpoints (public — not sensitive). Names match the Makefile's
# chain suffixes: deploy-factory-<chain> / create-jar-<chain>.
RPC_sepolia=https://ethereum-sepolia-rpc.publicnode.com
RPC_baseSepolia=https://base-sepolia-rpc.publicnode.com
RPC_optimismSepolia=https://optimism-sepolia-rpc.publicnode.com
RPC_arbitrumSepolia=https://arbitrum-sepolia-rpc.publicnode.com

# (Optional) for --verify on deploys
ETHERSCAN_API_KEY=

# Set after running DeployJarFactory — reused by DeployJar to create jars
JAR_FACTORY_ADDRESS=

# Parameters for a single jar created via DeployJar.
# JAR_TOKEN is also allowlisted automatically by DeployJarFactory.
JAR_NAME="Trip to Japan"
JAR_TOKEN=
JAR_GOAL=5000000000000000000000
